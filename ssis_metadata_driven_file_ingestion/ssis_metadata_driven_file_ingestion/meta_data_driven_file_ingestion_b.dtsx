        <SQLTask:SqlTaskData
          SQLTask:Connection="{534A8458-24D2-428B-ACD4-246601655E04}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SELECT&#xA;    FilePath,&#xA;    FileNamePattern,&#xA;    Delimiter,&#xA;    HasHeader,&#xA;    FieldCount,&#xA;    CAST(ISNULL(FieldNames, '') AS VARCHAR(8000)) AS FieldNames,&#xA;    StagingSchema,&#xA;    StagingTable,&#xA;    CAST(ISNULL(ArchivePath, '') AS VARCHAR(500)) AS ArchivePath&#xA;FROM test.FileConfig&#xA;WHERE FeedName = ?&#xA;  AND IsActive = 1;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::FilePath" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::FileNamePattern" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="2"
            SQLTask:DtsVariableName="User::Delimiter" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="3"
            SQLTask:DtsVariableName="User::HasHeader" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="4"
            SQLTask:DtsVariableName="User::FieldCount" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="5"
            SQLTask:DtsVariableName="User::FieldNames" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="6"
            SQLTask:DtsVariableName="User::StagingSchema" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="7"
            SQLTask:DtsVariableName="User::StagingTable" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="8"
            SQLTask:DtsVariableName="User::ArchivePath" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::FeedName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
